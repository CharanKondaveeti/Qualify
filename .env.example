# Public browser configuration ONLY (safe to commit).
# Set real values in Vercel environment variables; never commit secrets.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Never add SUPABASE_SERVICE_ROLE_KEY, email API keys, SMTP passwords,
# OTP HMAC secrets or other privileged secrets to a VITE_ variable.
